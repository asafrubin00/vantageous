{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src * 'unsafe-inline' 'unsafe-eval' data: blob:"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/((?!api/|@vite|@react-refresh|node_modules|src/).*)","destination": "/index.html" }
  ]
}
